name: {{ bootwright_current_load_balancer.name }}
runtime: {{ bootwright_current_load_balancer.runtime }}
providerRef: {{ bootwright_current_load_balancer.providerRef }}
providerHostRef: {{ bootwright_current_load_balancer.placement.providerHostRef }}
image:
  local: {{ bootwright_current_load_balancer.image.local | default('') }}
  public: {{ bootwright_current_load_balancer.image.public | default('') }}
frontends:
{% for frontend in bootwright_current_load_balancer.frontends %}
  - name: {{ frontend.name }}
    endpointRef: {{ frontend.endpointRef }}
    ports:
{% for port in frontend.ports %}
      - listenPort: {{ port.listenPort }}
        targetPort: {{ port.targetPort }}
{% endfor %}
    bindings:
{% for binding in frontend.bindings %}
      - clusterName: {{ binding.clusterName }}
        bindAddress: {{ binding.bindAddress }}
        backends:
{% for backend in binding.backends %}
          - name: {{ backend.name }}
            address: {{ backend.address }}
            role: {{ backend.role }}
{% endfor %}
{% endfor %}
{% endfor %}
